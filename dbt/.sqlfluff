[sqlfluff]
dialect = postgres
templater = jinja
max_line_length = 160
# some models (e.g. stg_teledeclarations.sql) are wide, legitimate files above
# the default 20000-byte parser-lock guard
large_file_skip_byte_limit = 60000
# LT01/LT02: this codebase intentionally column-aligns "as" aliases, which
# conflicts with sqlfluff's single-space/strict-indent defaults.
# ST06: false-positives on the standard `select * from {{ source(...) }}` CTE
# boilerplate used in every staging model.
# RF02/RF04: real findings (ambiguous unqualified refs, keyword-as-identifier)
# concentrated in the big reporting marts (mart_teledeclarations, mart_spe_bilan*)
# — ~400 occurrences. Fixing them means manually qualifying columns across
# hundreds of lines of EGalim compliance business logic; too risky to bulk-fix
# blind. Tracked as follow-up cleanup, not enforced yet.
# LT05/LT09/AL03/AL09/ST01/AM06/AM03: style-only, but sqlfluff's autofix for
# LT09 (select targets on their own line) mangled indentation inside nested
# subqueries when tried — needs a manual pass, not a blind `fix --force`.
exclude_rules = LT01, LT02, ST06, RF02, RF04, LT05, LT09, AL03, AL09, ST01, AM06, AM03

[sqlfluff:templater:jinja]
apply_dbt_builtins = true

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:layout:type:comma]
line_position = trailing

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
capitalisation_policy = lower
